# ─────────────────────────────────────────────────────────────
# WriteGrow AI — environment variables
# Copy this file to ".env.local" and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Supabase (required) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server only, NEVER expose to the browser.
# Used for trusted server actions (e.g. seeding). Optional for the MVP.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (optional for MVP) — if missing, the coach falls back to a
# built-in offline coach so the app still runs end to end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (placeholders — not wired up in the MVP)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAMILY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
