# ─────────────────────────────────────────────────────────────
# WriteGrow AI — environment variables
# Copy this file to ".env.local" and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Supabase (required) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server only, NEVER expose to the browser.
# Used for trusted server actions (e.g. seeding). Optional for the MVP.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (optional for MVP) — if missing, the coach falls back to a
# built-in offline coach so the app still runs end to end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Checkout runs in Supabase Edge Functions, not GitHub Pages.
# Do not add Stripe secret keys to this file or any NEXT_PUBLIC_* variable.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set these two secrets only in Supabase Edge Functions, never NEXT_PUBLIC_*.
# WRITEGROW_STRIPE_TEST_SECRET_KEY=sk_test_...
# WRITEGROW_STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# Defaults to test mode. Live checkout also requires explicit launch approval,
# separate live secrets, WRITEGROW_PILOT_MODE=live,
# WRITEGROW_PILOT_LIVE_ENABLED=true, and an enabled live database campaign.
# See docs/paid-pilot.md before changing payment settings.
